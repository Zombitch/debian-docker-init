# {{ ansible_managed }}
FROM {{ eva_node_image }}

ARG EVA_REF={{ eva_ref }}
# Changes daily (see eva.yml) so the layers below are refreshed from the network.
ARG CACHEBUST=0
# Unpinned on purpose: always the newest Angular CLI.
RUN echo "refresh ${CACHEBUST}" && npm install -g @angular/cli && npm cache clean --force

USER node
WORKDIR /home/node
RUN echo "refresh ${CACHEBUST}" \
    && wget -q -O eva.zip "https://github.com/Zombitch/eva/archive/${EVA_REF}.zip" \
    && unzip -q eva.zip \
    && rm eva.zip \
    && mv eva-* app \
    && cd app \
    && (npm ci || npm install)

WORKDIR /home/node/app
EXPOSE 4200
# Development server: fine for a private tool behind nginx, not a production build.
CMD ["ng", "serve", "--host", "0.0.0.0", "--allowed-hosts", "all"]
