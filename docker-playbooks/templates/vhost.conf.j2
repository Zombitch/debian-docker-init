# {{ ansible_managed }}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ domain }}{% if www_alias | default(false) | bool %} www.{{ domain }}{% endif %};

    ssl_certificate     /etc/nginx/letsencrypt/live/{{ domain }}/fullchain.pem;
    ssl_certificate_key /etc/nginx/letsencrypt/live/{{ domain }}/privkey.pem;

    # TLS 1.2+ with AEAD ciphers only (TLS 1.3 suites are not configurable/needed)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;

    # Resolve the upstream at request time (docker DNS) so a stopped container
    # does not stop nginx from starting or reloading.
    resolver 127.0.0.11 valid=10s;
    set $upstream http://{{ docker_host }};

    location / {
        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1h;
    }
}
